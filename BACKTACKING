      "source": [
        "# Variables (Students)\n",
        "students = [\"A\", \"B\", \"C\"]\n",
        "\n",
        "# Domain (Available Seats)\n",
        "seats = [1, 2, 3]\n",
        "\n",
        "# Dictionary to store assignments\n",
        "assignment = {}\n",
        "\n",
        "# Function to check whether assigning a seat is valid\n",
        "def is_valid(student, seat):\n",
        "    # Constraint 1: A cannot sit in Seat 2\n",
        "    if student == \"A\" and seat == 2:\n",
        "        return False\n",
        "\n",
        "    # Constraint 2: No two students can have the same seat\n",
        "    if seat in assignment.values():\n",
        "        return False\n",
        "\n",
        "    return True\n",
        "\n",
        "# Backtracking algorithm\n",
        "def backtrack(index):\n",
        "    # If all students are assigned\n",
        "    if index == len(students):\n",
        "        return True\n",
        "\n",
        "    student = students[index]\n",
        "\n",
        "    # Try every seat\n",
        "    for seat in seats:\n",
        "        if is_valid(student, seat):\n",
        "            assignment[student] = seat\n",
        "\n",
        "            if backtrack(index + 1):\n",
        "                return True\n",
        "\n",
        "            # Backtrack\n",
        "            del assignment[student]\n",
        "\n",
        "    return False\n",
        "\n",
        "# Solve the CSP\n",
        "if backtrack(0):\n",
        "    print(\"Solution Found:\")\n",
        "    for student, seat in assignment.items():\n",
        "        print(f\"{student} --> Seat {seat}\")\n",
        "else:\n",
        "    print(\"No solution exists.\")"
