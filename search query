      "source": [
        "from sklearn.feature_extraction.text import TfidfVectorizer\n",
        "from sklearn.metrics.pairwise import cosine_similarity\n",
        "\n",
        "# -----------------------------\n",
        "# Sample Web Pages (Documents)\n",
        "# -----------------------------\n",
        "documents = [\n",
        "    \"Python is a programming language used for AI and Machine Learning.\",\n",
        "    \"Docker is a containerization platform used for deploying applications.\",\n",
        "    \"Convolutional Neural Networks are used in image classification.\",\n",
        "    \"Machine Learning includes supervised and unsupervised learning.\",\n",
        "    \"Deep Learning is a subset of Machine Learning.\"\n",
        "]\n",
        "\n",
        "# -----------------------------\n",
        "# User Search Query\n",
        "# -----------------------------\n",
        "query = input(\"Enter your search query: \")\n",
        "\n",
        "# -----------------------------\n",
        "# Convert text into TF-IDF vectors\n",
        "# -----------------------------\n",
        "vectorizer = TfidfVectorizer()\n",
        "\n",
        "all_text = documents + [query]\n",
        "\n",
        "tfidf_matrix = vectorizer.fit_transform(all_text)\n",
        "\n",
        "# -----------------------------\n",
        "# Calculate Similarity\n",
        "# -----------------------------\n",
        "query_vector = tfidf_matrix[-1]\n",
        "\n",
        "document_vectors = tfidf_matrix[:-1]\n",
        "\n",
        "similarity = cosine_similarity(query_vector, document_vectors)\n",
        "\n",
        "# -----------------------------\n",
        "# Rank Documents\n",
        "# -----------------------------\n",
        "scores = similarity.flatten()\n",
        "\n",
        "ranked = sorted(enumerate(scores),\n",
        "                key=lambda x: x[1],\n",
        "                reverse=True)\n",
        "\n",
        "# -----------------------------\n",
        "# Display Results\n",
        "# -----------------------------\n",
        "print(\"\\nTop Search Results\\n\")\n",
        "\n",
        "for index, score in ranked:\n",
        "    print(f\"Score: {score:.3f}\")\n",
        "    print(documents[index])\n",
        "    print(\"-\"*60)\n"
      ],
