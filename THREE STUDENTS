        "import itertools\n",
        "\n",
        "students = ['A', 'B', 'C']\n",
        "seats = [1, 2, 3]\n",
        "\n",
        "valid_assignments = []\n",
        "\n",
        "for assignment in itertools.permutations(seats):\n",
        "    A, B, C = assignment\n",
        "\n",
        "    # Constraints\n",
        "    if A != 2 and B > C:\n",
        "        valid_assignments.append((A, B, C))\n",
        "\n",
        "print(\"Valid Seat Assignments:\")\n",
        "\n",
        "for A, B, C in valid_assignments:\n",
        "    print(\"A -> Seat\", A, \", B -> Seat\", B, \", C -> Seat\", C)"
      ],
