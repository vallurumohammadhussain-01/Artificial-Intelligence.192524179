    {
      "cell_type": "code",
      "source": [
        "N = 8\n",
        "board = [-1] * N\n",
        "\n",
        "def safe(row, col):\n",
        "    for i in range(row):\n",
        "        if board[i] == col or abs(board[i] - col) == abs(i - row):\n",
        "            return False\n",
        "    return True\n",
        "\n",
        "def solve(row):\n",
        "    if row == N:\n",
        "        return True\n",
        "\n",
        "    for col in range(N):\n",
        "        if safe(row, col):\n",
        "            board[row] = col\n",
        "            if solve(row + 1):\n",
        "                return True\n",
        "            board[row] = -1\n",
        "\n",
        "    return False\n",
        "\n",
        "solve(0)\n",
        "\n",
        "print(\"8-Queen Solution:\")\n",
        "for i in range(N):\n",
        "    for j in range(N):\n",
        "        if board[i] == j:\n",
        "            print(\"Q\", end=\" \")\n",
        "        else:\n",
        "            print(\".\", end=\" \")\n",
        "    print()"
