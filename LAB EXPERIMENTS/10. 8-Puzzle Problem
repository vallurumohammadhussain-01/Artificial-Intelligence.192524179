      "cell_type": "code",
      "source": [
        "from collections import deque\n",
        "\n",
        "start = tuple(map(int, input(\"Enter 9 numbers (0 for blank): \").split()))\n",
        "goal = (1, 2, 3, 4, 5, 6, 7, 8, 0)\n",
        "\n",
        "q = deque([(start, [])])\n",
        "visited = {start}\n",
        "\n",
        "moves = [-3, 3, -1, 1]\n",
        "\n",
        "while q:\n",
        "    state, path = q.popleft()\n",
        "\n",
        "    if state == goal:\n",
        "        print(\"Solution:\")\n",
        "        for p in path:\n",
        "            print(p)\n",
        "        break\n",
        "\n",
        "    zero = state.index(0)\n",
        "    row = zero // 3\n",
        "    col = zero % 3\n",
        "\n",
        "    for m in moves:\n",
        "        new = zero + m\n",
        "\n",
        "        if 0 <= new < 9:\n",
        "            if m == -1 and col == 0:\n",
        "                continue\n",
        "            if m == 1 and col == 2:\n",
        "                continue\n",
        "\n",
        "            s = list(state)\n",
        "            s[zero], s[new] = s[new], s[zero]\n",
        "            s = tuple(s)\n",
        "\n",
        "            if s not in visited:\n",
        "                visited.add(s)\n",
        "                q.append((s, path + [s]))\n",
        "\n",
        "else:\n",
        "    print(\"No solution\")"
