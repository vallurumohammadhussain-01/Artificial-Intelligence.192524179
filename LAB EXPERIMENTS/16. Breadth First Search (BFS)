      "cell_type": "code",
      "source": [
        "from collections import deque\n",
        "\n",
        "graph = {\n",
        "    'A': ['B', 'C'],\n",
        "    'B': ['D', 'E'],\n",
        "    'C': ['F'],\n",
        "    'D': [],\n",
        "    'E': [],\n",
        "    'F': []\n",
        "}\n",
        "\n",
        "start = input(\"Enter starting node: \")\n",
        "\n",
        "visited = set()\n",
        "q = deque([start])\n",
        "\n",
        "print(\"BFS:\", end=\" \")\n",
        "\n",
        "while q:\n",
        "    node = q.popleft()\n",
        "\n",
        "    if node not in visited:\n",
        "        print(node, end=\" \")\n",
        "        visited.add(node)\n",
        "\n",
        "        for x in graph[node]:\n",
        "            q.append(x)"
