    {
      "cell_type": "code",
      "source": [
        "from collections import deque\n",
        "\n",
        "a = int(input(\"Enter capacity of jug A: \"))\n",
        "b = int(input(\"Enter capacity of jug B: \"))\n",
        "target = int(input(\"Enter target amount: \"))\n",
        "\n",
        "q = deque([((0, 0), [])])\n",
        "visited = {(0, 0)}\n",
        "\n",
        "while q:\n",
        "    (x, y), path = q.popleft()\n",
        "\n",
        "    if x == target or y == target:\n",
        "        print(\"Steps:\")\n",
        "        for step in path:\n",
        "            print(step)\n",
        "        break\n",
        "\n",
        "    states = [\n",
        "        (a, y, \"Fill A\"),\n",
        "        (x, b, \"Fill B\"),\n",
        "        (0, y, \"Empty A\"),\n",
        "        (x, 0, \"Empty B\")\n",
        "    ]\n",
        "\n",
        "    pour = min(x, b-y)\n",
        "    states.append((x-pour, y+pour, \"Pour A to B\"))\n",
        "\n",
        "    pour = min(y, a-x)\n",
        "    states.append((x+pour, y-pour, \"Pour B to A\"))\n",
        "\n",
        "    for nx, ny, action in states:\n",
        "        if (nx, ny) not in visited:\n",
        "            visited.add((nx, ny))\n",
        "            q.append(((nx, ny), path + [action]))\n",
        "else:\n",
        "    print(\"No solution\")"
