        "import string\n",
        "\n",
        "s = input(\"Enter a string: \")\n",
        "\n",
        "result = \"\"\n",
        "\n",
        "for ch in s:\n",
        "    if ch not in string.punctuation:\n",
        "        result += ch\n",
        "\n",
        "print(\"After removing punctuation:\", result)"
      ],
