        "from itertools import permutations\n",
        "\n",
        "letters = \"SENDMORY\"\n",
        "\n",
        "for p in permutations(range(10), 8):\n",
        "    d = dict(zip(letters, p))\n",
        "\n",
        "    if d[\"S\"] == 0 or d[\"M\"] == 0:\n",
        "        continue\n",
        "\n",
        "    send = 1000*d[\"S\"] + 100*d[\"E\"] + 10*d[\"N\"] + d[\"D\"]\n",
        "    more = 1000*d[\"M\"] + 100*d[\"O\"] + 10*d[\"R\"] + d[\"E\"]\n",
        "    money = 10000*d[\"M\"] + 1000*d[\"O\"] + 100*d[\"N\"] + 10*d[\"E\"] + d[\"Y\"]\n",
        "\n",
        "    if send + more == money:\n",
        "        print(\"SEND =\", send)\n",
        "        print(\"MORE =\", more)\n",
        "        print(\"MONEY =\", money)\n",
        "        break"
      ],
