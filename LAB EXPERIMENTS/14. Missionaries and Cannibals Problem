      "source": [
        "from collections import deque\n",
        "\n",
        "start = (3, 3, 0)\n",
        "goal = (0, 0, 1)\n",
        "\n",
        "q = deque([(start, [])])\n",
        "visited = {start}\n",
        "\n",
        "def valid(m, c):\n",
        "    return (m == 0 or m >= c) and (m == 3 or (3-m) >= (3-c))\n",
        "\n",
        "while q:\n",
        "    state, path = q.popleft()\n",
        "    m, c, boat = state\n",
        "\n",
        "    if state == goal:\n",
        "        print(\"Solution:\")\n",
        "        for x in path:\n",
        "            print(x)\n",
        "        break\n",
        "\n",
        "    moves = [(1,0), (2,0), (0,1), (0,2), (1,1)]\n",
        "\n",
        "    for dm, dc in moves:\n",
        "        if boat == 0:\n",
        "            nm, nc = m-dm, c-dc\n",
        "            nb = 1\n",
        "            action = f\"Send {dm}M {dc}C\"\n",
        "        else:\n",
        "            nm, nc = m+dm, c+dc\n",
        "            nb = 0\n",
        "            action = f\"Return {dm}M {dc}C\"\n",
        "\n",
        "        if 0 <= nm <= 3 and 0 <= nc <= 3 and valid(nm, nc):\n",
        "            new = (nm, nc, nb)\n",
        "            if new not in visited:\n",
        "                visited.add(new)\n",
        "                q.append((new, path + [action]))"
