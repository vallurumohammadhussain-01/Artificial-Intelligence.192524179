    {
      "cell_type": "code",
      "source": [
        "graph = {\n",
        "    'A': ['B', 'C'],\n",
        "    'B': ['D', 'E'],\n",
        "    'C': ['F'],\n",
        "    'D': [],\n",
        "    'E': [],\n",
        "    'F': []\n",
        "}\n",
        "\n",
        "visited = set()\n",
        "\n",
        "def dfs(node):\n",
        "    if node not in visited:\n",
        "        print(node, end=\" \")\n",
        "        visited.add(node)\n",
        "\n",
        "        for x in graph[node]:\n",
        "            dfs(x)\n",
        "\n",
        "start = input(\"Enter starting node: \")\n",
        "\n",
        "print(\"DFS:\", end=\" \")\n",
        "dfs(start)"
      ],
