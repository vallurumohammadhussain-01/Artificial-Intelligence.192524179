    {
      "cell_type": "code",
      "source": [
        "import heapq\n",
        "\n",
        "graph = {\n",
        "    'A': [('B', 1), ('C', 3)],\n",
        "    'B': [('D', 3), ('E', 1)],\n",
        "    'C': [('F', 2)],\n",
        "    'D': [('G', 2)],\n",
        "    'E': [('G', 2)],\n",
        "    'F': [('G', 1)],\n",
        "    'G': []\n",
        "}\n",
        "\n",
        "h = {\n",
        "    'A': 5,\n",
        "    'B': 4,\n",
        "    'C': 3,\n",
        "    'D': 2,\n",
        "    'E': 2,\n",
        "    'F': 1,\n",
        "    'G': 0\n",
        "}\n",
        "\n",
        "start = input(\"Enter start: \")\n",
        "goal = input(\"Enter goal: \")\n",
        "\n",
        "pq = [(h[start], 0, start, [start])]\n",
        "visited = set()\n",
        "\n",
        "while pq:\n",
        "    f, g, node, path = heapq.heappop(pq)\n",
        "\n",
        "    if node == goal:\n",
        "        print(\"Path:\", path)\n",
        "        print(\"Cost:\", g)\n",
        "        break\n",
        "\n",
        "    if node in visited:\n",
        "        continue\n",
        "\n",
        "    visited.add(node)\n",
        "\n",
        "    for next_node, cost in graph[node]:\n",
        "        new_g = g + cost\n",
        "        new_f = new_g + h[next_node]\n",
        "        heapq.heappush(pq, (new_f, new_g, next_node, path + [next_node]))"
      ],
