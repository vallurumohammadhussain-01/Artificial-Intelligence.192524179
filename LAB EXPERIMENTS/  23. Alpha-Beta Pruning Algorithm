    {
      "cell_type": "code",
      "source": [
        "def minimax(depth, node, maximizing, values, alpha, beta):\n",
        "\n",
        "    if depth == 3:\n",
        "        return values[node]\n",
        "\n",
        "    if maximizing:\n",
        "        best = -1000\n",
        "\n",
        "        for i in range(2):\n",
        "            value = minimax(\n",
        "                depth + 1,\n",
        "                node * 2 + i,\n",
        "                False,\n",
        "                values,\n",
        "                alpha,\n",
        "                beta\n",
        "            )\n",
        "\n",
        "            best = max(best, value)\n",
        "            alpha = max(alpha, best)\n",
        "\n",
        "            if beta <= alpha:\n",
        "                break\n",
        "\n",
        "        return best\n",
        "\n",
        "    else:\n",
        "        best = 1000\n",
        "\n",
        "        for i in range(2):\n",
        "            value = minimax(\n",
        "                depth + 1,\n",
        "                node * 2 + i,\n",
        "                True,\n",
        "                values,\n",
        "                alpha,\n",
        "                beta\n",
        "            )\n",
        "\n",
        "            best = min(best, value)\n",
        "            beta = min(beta, best)\n",
        "\n",
        "            if beta <= alpha:\n",
        "                break\n",
        "\n",
        "        return best\n",
        "\n",
        "\n",
        "values = [3, 5, 6, 9, 1, 2, 0, -1]\n",
        "\n",
        "result = minimax(0, 0, True, values, -1000, 1000)\n",
        "\n",
        "print(\"Optimal value:\", result)"
