      ]
    },
    {
      "cell_type": "code",
      "source": [
        "colors = [\"Red\", \"Green\", \"Blue\"]\n",
        "\n",
        "graph = {\n",
        "    \"A\": [\"B\", \"C\"],\n",
        "    \"B\": [\"A\", \"C\", \"D\"],\n",
        "    \"C\": [\"A\", \"B\", \"D\"],\n",
        "    \"D\": [\"B\", \"C\"]\n",
        "}\n",
        "\n",
        "color = {}\n",
        "\n",
        "def safe(node, c):\n",
        "    for neighbor in graph[node]:\n",
        "        if neighbor in color and color[neighbor] == c:\n",
        "            return False\n",
        "    return True\n",
        "\n",
        "def solve(nodes):\n",
        "    if not nodes:\n",
        "        return True\n",
        "\n",
        "    node = nodes[0]\n",
        "\n",
        "    for c in colors:\n",
        "        if safe(node, c):\n",
        "            color[node] = c\n",
        "\n",
        "            if solve(nodes[1:]):\n",
        "                return True\n",
        "\n",
        "            del color[node]\n",
        "\n",
        "    return False\n",
        "\n",
        "solve(list(graph.keys()))\n",
        "\n",
        "print(\"Map Coloring:\")\n",
        "for node in graph:\n",
        "    print(node, \"->\", color[node])"
